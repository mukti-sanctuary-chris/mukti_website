# Copy this file to .env.local and fill in the values from your Sanity
# project (see README.md's "Content management" section for exactly where
# to find each one). .env.local is gitignored — never commit real values.
# The same three NEXT_PUBLIC_ variables also need to be set in Vercel's
# project settings (Settings → Environment Variables) for the live site.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed locally to run scripts/migrate-to-sanity.mjs once. Not
# needed by the deployed site — don't add this one to Vercel.
SANITY_API_WRITE_TOKEN=

# Any long random string (e.g. `openssl rand -hex 32`). Must match the
# secret you enter when creating the Sanity webhook. Needed both locally
# and in Vercel.
SANITY_REVALIDATE_SECRET=
